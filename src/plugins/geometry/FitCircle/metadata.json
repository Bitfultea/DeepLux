{
    "id": "com.deeplux.plugin.fitcircle",
    "name": "FitCircle",
    "category": "geometry",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "对输入点集进行圆拟合",
    "ui": {
        "parameters": {
            "threshold": {
                "min": 0,
                "step": 1,
                "decimals": 1,
                "order": 10,
                "label": "阈值"
            },
            "iterations": {
                "min": 0,
                "step": 1,
                "decimals": 0,
                "order": 20,
                "label": "迭代次数"
            },
            "minRadius": {
                "min": 0,
                "step": 1,
                "decimals": 1,
                "order": 30,
                "label": "最小半径"
            },
            "maxRadius": {
                "min": 0,
                "step": 1,
                "decimals": 1,
                "order": 40,
                "label": "最大半径"
            }
        }
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Any",
                "required": false,
                "multiple": false
            },
            {
                "id": "fit_points",
                "displayName": "拟合点集",
                "type": "PointSet2D",
                "required": true,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Any",
                "required": false,
                "multiple": false
            },
            {
                "id": "circle_center_x",
                "displayName": "圆心X",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "circle_center_y",
                "displayName": "圆心Y",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "circle_radius",
                "displayName": "半径",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "circle_error",
                "displayName": "拟合误差",
                "type": "Number",
                "required": false,
                "multiple": false
            }
        ]
    }
}
