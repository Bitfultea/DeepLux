{
    "id": "com.deeplux.plugin.fitplane",
    "name": "FitPlane",
    "category": "geometry",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "高度图 ROI（旋转矩形，0=全图）内最小二乘拟合平面：输出法向量/平面距离/平面度/偏差极值/RMS 与 Plane3D（平面上 3 个非共线点）",
    "ui": {
        "parameters": {
            "roiCenterX": {
                "min": 0,
                "max": 1000000,
                "step": 1,
                "decimals": 0,
                "order": 10,
                "label": "ROI 中心X（当前输入高度图局部像素）"
            },
            "roiCenterY": {
                "min": 0,
                "max": 1000000,
                "step": 1,
                "decimals": 0,
                "order": 20,
                "label": "ROI 中心Y（当前输入高度图局部像素）"
            },
            "roiLength1": {
                "min": 0,
                "max": 1000000,
                "step": 1,
                "decimals": 0,
                "order": 30,
                "label": "ROI 长边（像素；0=全图）"
            },
            "roiLength2": {
                "min": 0,
                "max": 1000000,
                "step": 1,
                "decimals": 0,
                "order": 40,
                "label": "ROI 短边（像素；0=全图）"
            },
            "roiAngle": {
                "min": -360,
                "max": 360,
                "step": 0.5,
                "decimals": 2,
                "order": 50,
                "label": "ROI 角度（度）"
            },
            "pixelSizeX": {
                "min": 0.000001,
                "max": 1000000,
                "step": 0.0001,
                "decimals": 6,
                "order": 60,
                "label": "X 标定比例（单位/像素）"
            },
            "pixelSizeY": {
                "min": 0.000001,
                "max": 1000000,
                "step": 0.0001,
                "decimals": 6,
                "order": 70,
                "label": "Y 标定比例（单位/像素）"
            },
            "zScale": {
                "min": 0.000001,
                "max": 1000000,
                "step": 0.0001,
                "decimals": 6,
                "order": 80,
                "label": "Z 标定比例（单位/高度值）"
            },
            "invalidValue": {
                "min": -1000000000,
                "max": 1000000000,
                "step": 0.1,
                "decimals": 3,
                "order": 90,
                "label": "无效高度值"
            },
            "autoNoData": {
                "order": 100,
                "label": "自动 NoData 检测"
            }
        }
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "高度图",
                "type": "Any",
                "required": true,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Any",
                "required": false,
                "multiple": false
            },
            {
                "id": "plane",
                "displayName": "拟合平面",
                "type": "Plane3D",
                "required": false,
                "multiple": false
            },
            {
                "id": "plane_nx",
                "displayName": "法向量X",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "plane_ny",
                "displayName": "法向量Y",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "plane_nz",
                "displayName": "法向量Z",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "plane_d",
                "displayName": "平面距离",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "flatness",
                "displayName": "平面度",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "max_deviation",
                "displayName": "最大偏差",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "min_deviation",
                "displayName": "最小偏差",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "rms",
                "displayName": "RMS 偏差",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "valid_pixel_count",
                "displayName": "有效像素数",
                "type": "Number",
                "required": false,
                "multiple": false
            }
        ]
    }
}
