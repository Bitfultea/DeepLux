{
    "id": "com.deeplux.plugin.freeformsurface",
    "name": "FreeformSurface",
    "category": "geometry",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "处理和分析自由曲面点云数据",
    "ui": {
        "parameters": {
            "samplingInterval": {
                "min": 0,
                "step": 1,
                "decimals": 1,
                "order": 10,
                "label": "采样间隔"
            }
        }
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Any",
                "required": false,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Any",
                "required": false,
                "multiple": false
            }
        ]
    },
    "execution": {
        "threadSafe": false,
        "blocking": true
    }
}
