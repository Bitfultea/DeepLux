{
    "id": "com.deeplux.plugin.distancepl",
    "name": "DistancePL",
    "category": "geometry",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "计算点到直线的距离",
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Any",
                "required": false,
                "multiple": false
            },
            {
                "id": "point",
                "displayName": "点",
                "type": "Point2D",
                "required": true,
                "multiple": false
            },
            {
                "id": "line",
                "displayName": "线",
                "type": "Line2D",
                "required": true,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Any",
                "required": false,
                "multiple": false
            },
            {
                "id": "distance",
                "displayName": "距离",
                "type": "Number",
                "required": false,
                "multiple": false
            }
        ]
    }
}
