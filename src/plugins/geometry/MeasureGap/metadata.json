            {
                "id": "gap_delta_x",
                "displayName": "X 差值",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "gap_delta_y",
                "displayName": "Y 差值",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "gap_delta_z",
                "displayName": "Z 差值",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "measurement_dimension",
                "displayName": "测量维度",
                "type": "String",
                "required": false,
                "multiple": false
            }
        ]
