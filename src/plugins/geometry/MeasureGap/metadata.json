{
    "id": "com.deeplux.plugin.measuregap",
    "name": "MeasureGap",
    "category": "geometry",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "测量两点之间的间隙距离",
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Any",
                "required": false,
                "multiple": false
            },
            {
                "id": "point1",
                "displayName": "点1",
                "type": "Any",
                "required": true,
                "multiple": false
            },
            {
                "id": "point2",
                "displayName": "点2",
                "type": "Any",
                "required": true,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Any",
                "required": false,
                "multiple": false
            },
            {
                "id": "gap",
                "displayName": "间隙",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "gap_distance",
