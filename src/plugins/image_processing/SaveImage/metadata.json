{
    "id": "com.deeplux.plugin.saveimage",
    "name": "SaveImage",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "Save image to file",
    "category": "image_processing",
    "depends": [],
    "platforms": [
        "windows",
        "linux"
    ],
    "keywords": [
        "save",
        "image",
        "file",
        "export"
    ],
    "ui": {
        "parameters": {
            "filePath": {
                "editor": "file",
                "order": 10,
                "label": "文件路径"
            },
            "format": {
                "order": 20,
                "label": "格式模板"
            },
            "quality": {
                "min": 0,
                "step": 1,
                "decimals": 1,
                "order": 30,
                "label": "质量"
            }
        }
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ]
    }
}
