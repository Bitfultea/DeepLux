{
    "id": "com.deeplux.plugin.perprocessing",
    "name": "PerProcessing",
    "category": "image_processing",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "图像预处理操作：滤波、锐化、形态学操作等",
    "ui": {
        "parameters": {
            "processType": {
                "order": 10,
                "label": "处理类型"
            },
            "kernelSize": {
                "min": 0,
                "step": 1,
                "decimals": 1,
                "order": 20,
                "label": "核大小"
            },
            "sigmaX": {
                "min": 0,
                "step": 1,
                "decimals": 1,
                "order": 30,
                "label": "Sigma X"
            },
            "iterations": {
                "min": 0,
                "step": 1,
                "decimals": 0,
                "order": 40,
                "label": "迭代次数"
            }
        }
    },
    "execution": {
        "threadSafe": false,
        "blocking": false
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ]
    }
}
