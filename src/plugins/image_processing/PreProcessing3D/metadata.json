{
    "id": "com.deeplux.plugin.3dpreprocessing",
    "name": "3DPreProcessing",
    "category": "image_processing",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "深度/高度图预处理：可设置原图像素 ROI、高度筛选、XYZ 缩放和步长下采样；高度筛选区间按输入单位计算，输出 Z/统计按 scaleZ 缩放，X/Y 按像素坐标缩放；有效/过滤统计针对下采样后的输出样本。填充值与存活高度碰撞时失败关闭。",
    "ui": {
        "parameters": {
            "heightFilterEnabled": {
                "order": 50,
                "label": "启用高度筛选"
            },
            "heightFilterMin": {
                "min": -1000000,
                "max": 1000000,
                "step": 0.1,
                "decimals": 3,
                "order": 60,
                "label": "输入高度下限"
            },
            "heightFilterMax": {
                "min": -1000000,
                "max": 1000000,
                "step": 0.1,
                "decimals": 3,
                "order": 70,
                "label": "输入高度上限"
            },
            "fillValue": {
                "min": -1000000,
                "max": 1000000,
                "step": 0.1,
                "decimals": 3,
                "order": 80,
                "label": "无效高度填充值（输入单位）"
            },
            "autoNoData": {
                "order": 90,
                "label": "自动 NoData 检测"
            },
            "roiCenterX": {
                "min": 0,
                "max": 1000000,
                "step": 1,
                "decimals": 0,
                "order": 10,
                "label": "ROI 中心X（当前输入深度/高度图局部像素）"
            },
            "roiCenterY": {
                "min": 0,
                "max": 1000000,
                "step": 1,
                "decimals": 0,
                "order": 20,
                "label": "ROI 中心Y（当前输入深度/高度图局部像素）"
            },
            "roiWidth": {
                "min": 0,
                "max": 1000000,
                "step": 1,
                "decimals": 0,
                "order": 30,
                "label": "ROI 宽度（像素；0=全宽）"
            },
            "roiHeight": {
                "min": 0,
                "max": 1000000,
                "step": 1,
                "decimals": 0,
                "order": 40,
                "label": "ROI 高度（像素；0=全高）"
            },
            "scaleX": {
                "min": 0.000001,
                "max": 1000000000,
                "step": 0.1,
                "decimals": 6,
                "order": 100,
                "label": "X 轴缩放（输出单位/像素）"
            },
            "scaleY": {
                "min": 0.000001,
                "max": 1000000000,
                "step": 0.1,
                "decimals": 6,
                "order": 110,
                "label": "Y 轴缩放（输出单位/像素）"
            },
            "scaleZ": {
                "min": 0.000001,
                "max": 1000000000,
                "step": 0.1,
                "decimals": 6,
                "order": 120,
                "label": "Z 轴缩放（输出高度单位/输入单位）"
            },
            "downsampleStep": {
                "min": 1,
                "max": 1024,
                "step": 1,
                "decimals": 0,
                "order": 130,
                "label": "下采样步长（1=不降采样）"
            }
        }
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "深度/高度图",
                "type": "Any",
                "required": true,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "预处理高度图",
                "type": "HeightMap2D",
                "required": false,
                "multiple": false
            },
            {
                "id": "valid_pixel_count",
                "displayName": "有效像素数",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "filtered_pixel_count",
                "displayName": "被填充像素数",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "min_height",
                "displayName": "存活最小高度",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "max_height",
                "displayName": "存活最大高度",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "height_invalid_value",
                "displayName": "无效高度值契约",
                "type": "Number",
                "required": false,
                "multiple": false
            }
        ]
    }
}
