{
    "id": "com.deeplux.plugin.imagescript",
    "name": "ImageScript",
    "category": "image_processing",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "按类型执行内置图像操作（反转/灰度/模糊/锐化）",
    "ui": {
        "parameters": {
            "scriptType": {
                "order": 10,
                "label": "内置图像操作",
                "_options": [
                    {"label": "图像反转", "value": 0},
                    {"label": "转灰度", "value": 1},
                    {"label": "模糊", "value": 2},
                    {"label": "锐化", "value": 3}
                ]
            }
        }
    },
    "execution": {
        "threadSafe": false,
        "blocking": false
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ]
    }
}
