{
    "id": "com.deeplux.plugin.imagescript",
    "name": "ImageScript",
    "category": "image_processing",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "按类型执行内置图像操作（反转/灰度/模糊/锐化）",
    "ui": {
        "parameters": {
            "scriptType": {
                "min": 0,
                "max": 3,
                "step": 1,
                "decimals": 0,
                "order": 10,
                "label": "内置图像操作"
            }
        }
    },
    "execution": {
        "threadSafe": false,
        "blocking": false
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ]
    }
}
