{
    "id": "com.deeplux.plugin.grabimage",
    "name": "GrabImage",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "Grab image from camera, file, or folder",
    "category": "image_processing",
    "depends": [],
    "platforms": [
        "windows",
        "linux"
    ],
    "keywords": [
        "camera",
        "grab",
        "image",
        "acquire"
    ],
    "ui": {
        "parameters": {
            "cameraId": {
                "label": "相机",
                "editor": "camera",
                "order": 10
            },
            "filePath": {
                "label": "图像路径",
                "editor": "fileOrFolder",
                "dialogTitle": "选择图像文件",
                "folderDialogTitle": "选择图像文件夹",
                "filter": "图像文件 (*.png *.jpg *.jpeg *.bmp *.tif *.tiff)",
                "setsParam": "grabSource",
                "setsValue": "Path",
                "order": 20
            },
            "folderPath": {
                "label": "文件夹路径",
                "editor": "folder",
                "dialogTitle": "选择图像文件夹",
                "hidden": true,
                "order": 22
            },
            "folderLoop": {
                "label": "末尾循环",
                "onText": "已开启",
                "offText": "已关闭",
                "order": 26
            },
            "exposureTime": {
                "label": "曝光时间",
                "unit": "us",
                "min": 0,
                "step": 100,
                "decimals": 0,
                "order": 30
            },
            "gain": {
                "label": "增益",
                "min": 0,
                "step": 0.1,
                "decimals": 2,
                "order": 40
            },
            "grabSource": {
                "label": "图像源",
                "_options": [
                    {"label": "相机", "value": "Camera"},
                    {"label": "自动路径", "value": "Path"},
                    {"label": "演示", "value": "Demo"}
                ],
                "order": 50
            },
            "grabTimeout": {
                "label": "采集超时",
                "unit": "ms",
                "min": 100,
                "max": 60000,
                "step": 100,
                "decimals": 0,
                "order": 60
            }
        }
    }
}
