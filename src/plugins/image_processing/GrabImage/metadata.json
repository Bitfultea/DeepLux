{
    "id": "com.deeplux.plugin.grabimage",
    "name": "GrabImage",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "Grab image from camera or file",
    "category": "image_processing",
    "depends": [],
    "platforms": [
        "windows",
        "linux"
    ],
    "keywords": [
        "camera",
        "grab",
        "image",
        "acquire"
    ],
    "ui": {
        "parameters": {
            "cameraId": {
                "label": "相机 ID",
                "order": 10
            },
            "filePath": {
                "label": "文件路径",
                "order": 20
            },
            "exposureTime": {
                "label": "曝光时间",
                "unit": "us",
                "min": 0,
                "step": 100,
                "order": 30
            },
            "gain": {
                "label": "增益",
                "min": 0,
                "step": 0.1,
                "order": 40
            },
            "grabSource": {
                "label": "采集来源",
                "_options": ["Camera", "File", "Demo"],
                "order": 50
            },
            "grabTimeout": {
                "label": "采集超时",
                "unit": "ms",
                "min": 100,
                "step": 100,
                "order": 60
            }
        }
    }
}
