{
    "id": "com.deeplux.plugin.cropimage",
    "name": "CropImage",
    "category": "image_processing",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "旋转矩形数组（1..64 个 [cx,cy,l1,l2,deg]）批量裁剪：逐矩形取轴对齐包围盒与图像求交，输出裁剪图组 Table 与计数；outputFirstAsImage 为真时 image 端口输出首个有效裁剪图；全部无交集失败关闭",
    "ui": {
        "parameters": {
            "rectangles": {
                "order": 10,
                "label": "矩形数组 [[cx,cy,l1,l2,deg],...]"
            },
            "outputFirstAsImage": {
                "order": 20,
                "label": "输出首裁剪图"
            }
        }
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入图像",
                "type": "Image2D",
                "required": true,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Image2D",
                "required": false,
                "multiple": false
            },
            {
                "id": "crop_count",
                "displayName": "有效裁剪数",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "crop_images",
                "displayName": "裁剪图组",
                "type": "Table",
                "required": false,
                "multiple": false
            }
        ]
    }
}
