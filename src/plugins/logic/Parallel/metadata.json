{
    "id": "com.deeplux.plugin.parallel",
    "name": "Parallel",
    "category": "logic",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "并行执行由 branch 控制端口连接的线程安全分支",
    "ui": {
        "parameters": {
            "parallelCount": {
                "min": 2,
                "step": 1,
                "decimals": 0,
                "order": 10,
                "label": "最大并发数"
            }
        }
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Any",
                "required": false,
                "multiple": false
            },
            {
                "id": "control",
                "displayName": "控制输入",
                "type": "Boolean",
                "required": false,
                "multiple": true,
                "control": true,
                "joinPolicy": "all"
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Any",
                "required": false,
                "multiple": false
            },
            {
                "id": "branch",
                "displayName": "并行分支",
                "type": "Boolean",
                "required": false,
                "multiple": false,
                "control": true
            }
        ]
    }
}
