{
    "id": "com.deeplux.plugin.loop",
    "name": "循环",
    "category": "logic",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "按次数循环；无结束节点时循环紧随其后的模块",
    "ui": {
        "parameters": {
            "loopCount": {
                "min": 0,
                "step": 1,
                "decimals": 0,
                "order": 10,
                "label": "循环次数"
            }
        }
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Any",
                "required": false,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Any",
                "required": false,
                "multiple": false
            },
            {
                "id": "body",
                "displayName": "body",
                "type": "Boolean",
                "required": false,
                "multiple": false,
                "control": true
            },
            {
                "id": "done",
                "displayName": "done",
                "type": "Boolean",
                "required": false,
                "multiple": false,
                "control": true
            }
        ]
    }
}
