{
    "id": "com.deeplux.plugin.sampredict",
    "name": "SamPredict",
    "category": "detection",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "SAM 点/框 prompt 分割：调用 sam_server 完成 set_image+predict，输出强类型 Region2D（polygon/bbox/maskRle/score/label）；超时或后端错误失败关闭",
    "ui": {
        "parameters": {
            "serverUrl": {
                "order": 10,
                "label": "SAM 服务地址"
            },
            "label": {
                "order": 20,
                "label": "区域类别标签"
            },
            "points": {
                "order": 30,
                "label": "正点 [[x,y],...]",
                "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
            },
            "negativePoints": {
                "order": 40,
                "label": "负点 [[x,y],...]",
                "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
            },
            "box": {
                "order": 50,
                "label": "框 [x,y,w,h]（可空）",
                "type": "array",
                "acceptedTypes": ["array", "null"],
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "number"}
            },
            "timeoutMs": {
                "min": 100,
                "max": 120000,
                "step": 100,
                "decimals": 0,
                "order": 60,
                "label": "超时(ms)"
            }
        },
        "results": {
            "region": {"label": "分割区域", "type": "Region2D", "order": 10},
            "score": {"label": "分割置信度", "type": "number", "order": 20}
        }
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入图像",
                "type": "Image2D",
                "required": true,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Any",
                "required": false,
                "multiple": false
            },
            {
                "id": "region",
                "displayName": "分割区域",
                "type": "Region2D",
                "required": false,
                "multiple": false
            },
            {
                "id": "score",
                "displayName": "置信度",
                "type": "Number",
                "required": false,
                "multiple": false
            }
        ]
    }
}
