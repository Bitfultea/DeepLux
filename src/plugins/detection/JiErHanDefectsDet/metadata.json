{
    "id": "com.deeplux.plugin.jierhandefectsdet",
    "name": "JiErHanDefectsDet",
    "category": "detection",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "实验性候选检测：基于边缘+轮廓启发式定位焊接缺陷候选区域（非真实工业模型）",
    "ui": {
        "parameters": {
            "threshold": {
                "min": 0.1,
                "max": 1.0,
                "step": 0.05,
                "decimals": 2,
                "order": 10,
                "label": "检测阈值（置信度下限）"
            }
        }
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ]
    }
}
