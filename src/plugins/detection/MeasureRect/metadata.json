{
    "id": "com.deeplux.plugin.measurerect",
    "name": "MeasureRect",
    "category": "detection",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "检测并测量图像中的矩形",
    "ui": {
        "parameters": {
            "minArea": {
                "min": 0,
                "step": 10,
                "decimals": 0,
                "order": 10,
                "label": "最小面积"
            },
            "maxArea": {
                "min": 0,
                "step": 10,
                "decimals": 0,
                "order": 20,
                "label": "最大面积"
            },
            "threshold1": {
                "min": 0,
                "step": 1,
                "decimals": 1,
                "order": 30,
                "label": "阈值1"
            },
            "threshold2": {
                "min": 0,
                "step": 1,
                "decimals": 1,
                "order": 40,
                "label": "阈值2"
            }
        }
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Image2D",
                "required": false,
                "multiple": false
            },
            {
                "id": "rect_width",
                "displayName": "宽",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "rect_height",
                "displayName": "高",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "rect_area",
                "displayName": "面积",
                "type": "Number",
                "required": false,
                "multiple": false
            }
        ]
    }
}
