{
    "id": "com.deeplux.plugin.matching",
    "name": "Matching",
    "category": "detection",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "在图像中查找与模板匹配的区域",
    "ui": {
        "parameters": {
            "matchThreshold": {
                "min": 0,
                "step": 1,
                "decimals": 1,
                "order": 10,
                "label": "匹配阈值"
            },
            "maxMatches": {
                "min": 0,
                "step": 1,
                "decimals": 1,
                "order": 20,
                "label": "最大匹配数"
            }
        }
    },
    "execution": {
        "threadSafe": false,
        "blocking": false
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Image2D",
                "required": false,
                "multiple": false
            },
            {
                "id": "match_count",
                "displayName": "匹配数量",
                "type": "Integer",
                "required": false,
                "multiple": false
            },
            {
                "id": "match_threshold",
                "displayName": "匹配阈值",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "match_x",
                "displayName": "匹配X",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "match_y",
                "displayName": "匹配Y",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "match_width",
                "displayName": "匹配宽",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "match_height",
                "displayName": "匹配高",
                "type": "Number",
                "required": false,
                "multiple": false
            },
            {
                "id": "detections",
                "displayName": "检测列表（强类型）",
                "type": "DetectionList",
                "required": false,
                "multiple": false
            }
        ]
    }
}
