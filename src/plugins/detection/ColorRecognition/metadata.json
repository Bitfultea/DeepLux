{
    "id": "com.deeplux.plugin.colorrecognition",
    "name": "ColorRecognition",
    "category": "detection",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "识别图像中的指定颜色区域",
    "ui": {
        "parameters": {
            "targetColor": {
                "order": 10,
                "label": "目标颜色"
            }
        }
    },
    "execution": {
        "threadSafe": false,
        "blocking": false
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Image2D",
                "required": false,
                "multiple": false
            }
        ]
    }
}
