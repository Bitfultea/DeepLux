{
    "id": "com.deeplux.plugin.strformat",
    "name": "字符串格式化",
    "category": "variable",
    "version": "1.0.0",
    "author": "DeepLux Team",
    "description": "格式化字符串并输出到变量",
    "ui": {
        "parameters": {
            "format": {
                "order": 10,
                "label": "格式模板"
            },
            "inputVariables": {
                "order": 20,
                "label": "输入变量",
                "maxItems": 256,
                "items": {"type": "string"}
            },
            "outputVariable": {
                "order": 30,
                "label": "输出变量"
            }
        },
        "results": {
            "$outputVariable": {
                "label": "格式化字符串",
                "type": "string",
                "keyFromParameter": "outputVariable",
                "order": 10
            }
        }
    },
    "ports": {
        "inputs": [
            {
                "id": "image",
                "displayName": "输入",
                "type": "Any",
                "required": false,
                "multiple": false
            }
        ],
        "outputs": [
            {
                "id": "image",
                "displayName": "输出",
                "type": "Any",
                "required": false,
                "multiple": false
            }
        ]
    }
}
