{
  "version": "3.0",
  "id": "accept-fitline-pointset-0001",
  "name": "验收-FitLine 图像坐标点集流程",
  "modules": [
    {"id": "grab", "moduleId": "GrabImage", "name": "图像采集", "params": {"grabSource": "File", "filePath": "@ACCEPTANCE_DATA@/fitline.png"}},
    {"id": "crop", "moduleId": "CropImage", "name": "偏移裁剪", "params": {"rectangles": [[80, 60, 30, 20, 0]], "outputFirstAsImage": true}},
    {"id": "input", "moduleId": "MeasurementInput", "name": "拟合点输入", "params": {"mode": "point_set", "points": [[13, 25], [17, 25], [21, 25], [25, 25], [29, 25], [33, 25], [37, 25]]}},
    {"id": "fit", "moduleId": "FitLine", "name": "拟合直线"}
  ],
  "connections": [
    {"fromModuleId": "grab", "toModuleId": "crop", "fromPort": "image", "toPort": "image", "edgeType": "data"},
    {"fromModuleId": "crop", "toModuleId": "input", "fromPort": "image", "toPort": "image", "edgeType": "data"},
    {"fromModuleId": "input", "toModuleId": "fit", "fromPort": "image", "toPort": "image", "edgeType": "data"},
    {"fromModuleId": "input", "toModuleId": "fit", "fromPort": "fit_points", "toPort": "fit_points", "edgeType": "data"}
  ],
  "flows": [{"id": "main", "name": "主流程", "nodes": ["grab", "crop", "input", "fit"]}],
  "resources": {"cameras": [], "dataSources": []}
}
